# Copy this file to a new file named .env (same folder) and paste your own key.
# .env is ignored by git, so your key is never committed.
OPENROUTER_API_KEY=
# Optional: where the app keeps users.json, audit_history.json, records/ and app.log.
# DATA_DIR=data
# Optional: the administrator account. On the first run with this set, the app
# asks you to choose this account's password. It can then open the Admin Console
# (menu option 11) and can never be demoted or deleted.
# ADMIN_USERNAME=admin
